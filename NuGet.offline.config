<?xml version="1.0" encoding="utf-8"?>
<!-- Offline NuGet config for Roslyn. Restores only from packages committed to this
     repo at eng/offline-packages (linux-x64 compiler subset). No network sources.
     A fresh git clone has everything needed to restore the compiler subset offline,
     provided a matching .NET SDK is installed (see global.json). See docs/Building Offline.md. -->
<configuration>
  <packageSources>
    <clear />
    <add key="offline-packages" value="eng/offline-packages" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
